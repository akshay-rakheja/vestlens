# VestLens self-hosted configuration. Copy to .env, fill in the required values below, then run `npm run setup`.
# Docker Compose reads this file as .env (or the file named by VESTLENS_ENV_FILE).
# Placeholders only: never commit a real .env.

# --- Required ---

# The address you reach this instance at. https, or http only for localhost, 127.0.0.1 or [::1]. No trailing path.
APP_BASE_URL=http://localhost:8080
# PostgreSQL connection string (the Docker Compose default; the database is not published outside Compose).
# connection_limit defaults to 5 when left out; below 3 the app refuses to start (each running background job holds one
# pooled connection).
# To change the password, set POSTGRES_PASSWORD for `db` in a docker-compose.override.yml (see README) and use the same
# value here, before the first start.
DATABASE_URL=postgresql://vestlens:vestlens@db:5432/vestlens?connection_limit=5
# Your SnapTrade Personal credentials (from the SnapTrade dashboard). Read-only access is all VestLens uses.
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key

# These three keys are generated into .env by `npm run setup`; do not fill them in by hand.
# OWNER_PASSWORD_HASH=       (your sign-in password, hashed; generated by `npm run setup`)
# SESSION_SECRET=            (keys the browser session cookie; generated by `npm run setup`)
# MCP_GATEWAY_SIGNING_KEY=   (signs the access tokens your AI apps receive; generated by `npm run setup`)

# --- Optional ---

# A retired signing key (public part is enough), kept for a while after a key rotation so existing AI app sessions survive.
# MCP_GATEWAY_PREVIOUS_SIGNING_KEY=

# Set to true to accept SnapTrade webhooks at /webhooks/snaptrade (verified with SNAPTRADE_CONSUMER_KEY). Default false.
# WEBHOOKS_ENABLED=false

# Set to true to turn on the news view. Then all of MARKETAUX_API_KEY, TYPESAFE_API_KEY and EDGAR_USER_AGENT are required
# (startup fails naming the missing one). Default false.
# NEWS_ENABLED=false
# Marketaux API key for headlines.
# MARKETAUX_API_KEY=your-marketaux-api-key
# Marketaux requests per day VestLens may spend (1 to 10000). Default 90.
# MARKETAUX_DAILY_BUDGET=90
# TypeSafe API key, used to rate headlines.
# TYPESAFE_API_KEY=your-typesafe-api-key
# TypeSafe model name. Default jev-1.13.0.
# TYPESAFE_MODEL=jev-1.13.0
# Your contact in the form SEC EDGAR asks for, such as "VestLens you@example.com".
# EDGAR_USER_AGENT=VestLens you@example.com

# How many reverse-proxy hops (1 to 5) to trust for the visitor's address in X-Forwarded-For. Leave unset when you reach
# VestLens directly on localhost: with it unset the header is ignored, so it cannot be forged to dodge the sign-in limit.
# Set 1 behind one proxy (a Cloudflare Tunnel, or a PaaS router), and only then.
# TRUST_PROXY=1

# Port the server listens on. Default 3004; the Docker image uses 8080.
# PORT=3004
# Where the built dashboard and widgets are served from. The Docker image sets both; leave unset otherwise.
# WEB_DIST_DIRECTORY=/app/packages/web/dist
# WIDGETS_DIST_DIRECTORY=/app/packages/widgets/dist
